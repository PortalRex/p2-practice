+// Skips one command-line word (quotes group) and the blanks after it.
+static const char* skip_word(const char* p) {
     if (*p == '"') { p++; while (*p && *p != '"') p++; if (*p) p++; }
     else { while (*p && *p != ' ' && *p != '\t') p++; }
     while (*p == ' ' || *p == '\t') p++;
     return p;
 }
 
+// True when the command line's first word, after the program name, is a path to portal2.exe: Steam's launch
+// options ran us as a wrapper ("chocoload.exe %command%"), and %command% starts with the game's own path.
+static bool started_by_steam(const char* args) {
+    const char* end = skip_word(args);
+    size_t n = end - args;
+    while (n && (args[n - 1] == ' ' || args[n - 1] == '\t' || args[n - 1] == '"')) n--;
+    return n >= 11 && _strnicmp(args + n - 11, "portal2.exe", 11) == 0;
+}
+
+// Our own command line minus the program name, exactly as typed (quotes preserved).
+static const char* forwarded_args() {
+    const char* p = skip_word(GetCommandLineA());
+    // (as a wrapper, the game's path that Steam put first is not one of the game's arguments)
+    return started_by_steam(p) ? skip_word(p) : p;
+}
