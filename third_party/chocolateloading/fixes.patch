+// Diagnostic: the modules of the frames on the stack, as " name:cls" entries (cls: P pass, S self, G game, O other)
+__declspec(noinline) void DescribeStack(char* out, size_t cap) {
+    out[0] = 0;
+    if (!g_backtrace || cap < 8) return;
+    void* frames[24];
+    USHORT n = g_backtrace(0, 24, frames, nullptr);
+    size_t used = 0;
+    for (USHORT i = 0; i < n && used + 40 < cap; i++) {
+        const char* nm;
+        int c = classify((uintptr_t)frames[i], &nm);
+        used += _snprintf_s(out + used, cap - used, _TRUNCATE, " %s+%x:%c", nm[0] ? nm : "?", (unsigned)((uintptr_t)frames[i] & 0xfffff),
+                            c == C_PASS ? 'P' : c == C_SELF ? 'S' : c == C_GAME ? 'G' : 'O');
+    }
+}
