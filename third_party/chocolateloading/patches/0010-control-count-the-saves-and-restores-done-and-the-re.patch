index f91b5c5..f352d9f 100644
--- a/src/control.cpp
+++ b/src/control.cpp
@@ -22,6 +22,7 @@ double   g_request_time = 0;
 uint32_t g_request_frame = 0;
 int      g_levelinits = 0;
 char     g_domain[1024] = "";
