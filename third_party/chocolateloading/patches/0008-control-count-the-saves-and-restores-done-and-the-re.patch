diff --git a/src/control.h b/src/control.h
index 9f4cc52..d7b637b 100644
--- a/src/control.h
+++ b/src/control.h
@@ -26,6 +26,11 @@ bool Busy();                  // an operation is queued
 // "[snap] map start save of '<name>' missed: ..." when it could not be taken before the first tick.
 bool ArmStartSave(const char* name);
 void OnGameFrame(bool simulating);   // server plugin GameFrame callback
+// What became of the requests so far, for a plugin that drives snapshots and waits for each (the export
+// ChocoGetSnapshotStatus): every request ends up counted once, as a save done, a restore done, or as failed
+// (refused, gone wrong, or dropped because the level ended first).
+struct Counts { uint32_t saved, restored, failed; };
+const Counts& Done();
 void OnFrameStart();          // drive the queue; call once per FRAME_START
 uint32_t Frame();             // FRAME_STARTs seen so far
 
diff --git a/src/plugin.cpp b/src/plugin.cpp
index 137be78..abaf512 100644
--- a/src/plugin.cpp
+++ b/src/plugin.cpp
@@ -294,6 +294,26 @@ extern "C" __declspec(dllexport) int ChocoRestoresDeviceState() {
     return snapshot::Opts().device_state ? 1 : 0;
 }
 
+// For plugins that drive snapshots (snap_save / snap_load run a few frames after the command): how many saves
+// and restores have been done and how many requests failed, so that the plugin can wait for the one it asked
+// for instead of guessing when it has happened. The caller sets `size`; 0 is returned for a size not known here.
+struct ChocoSnapshotStatus {
+    unsigned size;
+    unsigned saved, restored;       // saves and restores done since the game started
+    unsigned failed;                // requests refused, gone wrong, or dropped because the level ended first
+    unsigned keeps_render_thread;   // 1: queued rendering stays on through an operation (snap_opt render_lock)
+};
+
+extern "C" __declspec(dllexport) int ChocoGetSnapshotStatus(ChocoSnapshotStatus* out) {
+    if (!out || out->size != sizeof(ChocoSnapshotStatus)) return 0;
+    const control::Counts& done = control::Done();
+    out->saved = done.saved;
+    out->restored = done.restored;
+    out->failed = done.failed;
+    out->keeps_render_thread = snapshot::RenderLockUsable() ? 1 : 0;
+    return 1;
+}
+
 extern "C" __declspec(dllexport) void* CreateInterface(const char* name, int* ret) {
     // The engine dispatches to fixed vtable slots (ClientActive = 9, ClientFullyConnect = 10, ...),
     // i.e. the 003 layout, which is what IServerPluginCallbacks implements.
