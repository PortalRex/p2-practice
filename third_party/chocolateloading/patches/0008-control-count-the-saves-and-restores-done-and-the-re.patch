 uint32_t Frame() { return g_frame; }
 
 void OnFrameStart() {
@@ -318,6 +323,7 @@ void OnLevelInit(const char* map) {
 }
 
 void OnLevelShutdown() {
+    if (g_pending != OP_NONE) g_done.failed++;   // (the level ended before its frame came)
     g_pending = OP_NONE;
