 }
 
+// ---- cvars whose object lives outside the snapshot -------------------------------------------------
+// A plugin's cvars (SAR's sar_*) are ConVar objects in the plugin's own memory, which a restore leaves as it
+// is, but their value strings are allocated by the engine's ConVar code, in the arena, which a restore
+// reverts: a value set after the save was a block the restore freed, so the cvar went on pointing at a freed
+// block that was soon reused. SAR's sar_record_prefix then read as garbage: demos started with mangled
+// names ("9ÿB0....dem"), SAR's rename at the flags failed and closed the game, and once strftime got an
+// invalid format from it and SAR's CRT closed the game (fast fail, invalid parameter). So the text of every
+// such cvar is noted before a restore and given a fresh copy in the arena after it; the object keeps the
+// value it had, as the rest of the plugin's memory does.
+struct KeptVar { ConVar* var; size_t at; size_t len; };
+KeptVar g_kept_vars[2048];
+int     g_kept_count = 0;
+char    g_kept_text[128 * 1024];
+
+bool readable_cvar(const ConCommandBase* b) {
+    MEMORY_BASIC_INFORMATION mbi;
+    return VirtualQuery(b, &mbi, sizeof(mbi)) && mbi.State == MEM_COMMIT &&
+           !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)) && (uintptr_t)b + sizeof(ConVar) <= (uintptr_t)mbi.BaseAddress + mbi.RegionSize;
+}
+
+void cvars_before_restore() {
+    g_kept_count = 0;
+    size_t used = 0;
+    int walked = 0;
+    for (ConCommandBase* b = gameapi::FirstCommand(); b && walked < 100000; b = b->m_pNext, walked++) {
+        if (!readable_cvar(b)) break;
+        if (vfunc<bool(__thiscall*)(void*)>(b, 1)(b)) continue;   // IsCommand
+        ConVar* v = (ConVar*)b;
+        if (v->m_pParent != v || arena::Contains(v) || memhook::InDomainModule(v)) continue;   // reverted with the rest
+        const char* s = v->m_pszString;
+        if (!s || !arena::Contains(s)) continue;
+        size_t len = strnlen(s, v->m_StringLength > 0 ? (size_t)v->m_StringLength : 4096);
+        if (g_kept_count == (int)(sizeof(g_kept_vars) / sizeof(g_kept_vars[0])) || used + len + 1 > sizeof(g_kept_text)) break;
+        memcpy(g_kept_text + used, s, len);
+        g_kept_text[used + len] = 0;
+        g_kept_vars[g_kept_count++] = {v, used, len};
+        used += len + 1;
+    }
+}
+
+// After the restore, with the other threads running again (an allocation takes the arena's lock)
+void cvars_after_restore() {
+    for (int i = 0; i < g_kept_count; i++) {
+        KeptVar& k = g_kept_vars[i];
+        char* copy = (char*)arena::Alloc(k.len + 1);
+        if (!copy) break;
+        memcpy(copy, g_kept_text + k.at, k.len + 1);
+        // (the block it pointed to is left alone: freed by the restore, or still the snapshot's own)
+        k.var->m_pszString = copy;
+        k.var->m_StringLength = (int)(k.len + 1);
+    }
+    if (g_kept_count) util::Log("[snap] %d cvars outside the snapshot given their value back", g_kept_count);
+    g_kept_count = 0;
+}
+
 bool g_pool_suspended = false, g_fs_suspended = false;
 
 // Drain and park the job pool and the async filesystem so no job runs while memory is copied.
@@ -560,6 +616,49 @@ bool write_image(const Snap& s, uintptr_t end) {
     return pieces_run(s.section, true) && listed;
 }
 
+// ---- dirty arena pages, copied back by the copy workers ----------------------------------------------
+// The pages written since the save (sorted, from the write watch) are grouped by WINDOW of the image; each
+// window is one job: a worker maps that part of the store and copies its pages back. On the main thread
+// alone, through one sliding view, this was the largest part of a restore (5-6 ms for ~4000 pages).
+const size_t MAX_WINDOWS = 64;   // 2 GB of arena image in 32 MB windows
+size_t g_win_index[MAX_WINDOWS], g_win_first[MAX_WINDOWS], g_win_count[MAX_WINDOWS];
+const Snap* g_dirty_snap = nullptr;
+
+void dirty_window_copy(void*, int w) {
+    const Snap& s = *g_dirty_snap;
+    uintptr_t base = arena::Base();
+    size_t at = g_win_index[w] * WINDOW;
+    size_t vlen = s.section_size - at < WINDOW ? s.section_size - at : WINDOW;
+    const uint8_t* v = (const uint8_t*)MapViewOfFile(s.section, FILE_MAP_READ, 0, (DWORD)at, vlen);
+    if (!v) { InterlockedExchange(&g_job_failed, 1); return; }
+    for (size_t k = g_win_first[w], e = k + g_win_count[w]; k < e; k++) {
+        uintptr_t a = g_dirty[k], b = a + 4096;
+        if (a < base) a = base;
+        if (b > s.image_end) b = s.image_end;
+        if (a < b) memcpy((void*)a, v + (a - base - at), b - a);
+    }
+    UnmapViewOfFile(v);
+}
+
+bool revert_dirty_parallel(const Snap& s, size_t n) {
+    uintptr_t base = arena::Base();
+    int windows = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (g_dirty[i] + 4096 <= base || g_dirty[i] >= s.image_end) continue;
+        size_t index = (g_dirty[i] < base ? 0 : g_dirty[i] - base) / WINDOW;
+        if (windows && g_win_index[windows - 1] == index) { g_win_count[windows - 1]++; continue; }
+        if (windows == (int)MAX_WINDOWS) return false;
+        g_win_index[windows] = index;
+        g_win_first[windows] = i;
+        g_win_count[windows] = 1;
+        windows++;
+    }
+    g_dirty_snap = &s;
+    g_job_failed = 0;
+    copypool::Run(dirty_window_copy, nullptr, windows);
+    return !g_job_failed;
+}
+
 // ---- restore steps -----------------------------------------------------------------------------------
 // The current snapshot: copies back the arena pages written since it was saved or restored, skipping the
 // `kept` zombie ranges `z` (sorted). *pages receives the number of pages examined.
@@ -572,6 +671,7 @@ bool revert_dirty_pages(const Snap& s, const arena::Range* z, size_t kept, size_
         return restore_range(s, arena::Base(), s.image_end, z, kept);
     }
     *pages = n;
+    if (!kept) return revert_dirty_parallel(s, n);
     for (size_t i = 0; i < n; i++) {
         uintptr_t a = g_dirty[i], b = a + 4096;
         if (a < arena::Base()) a = arena::Base();
@@ -859,6 +959,7 @@ bool Restore(const char* name, char* err, size_t errlen) {
 
     // 1) let go of the outside objects of the timeline being discarded, with the other threads running
     stop_all_sounds();
+    cvars_before_restore();
     guards_before_restore(slot);
     quiesce_begin();
     save_preserved();
@@ -913,7 +1014,8 @@ bool Restore(const char* name, char* err, size_t errlen) {
     util::MuteConsole(false);
     quiesce_end();
     double t2 = util::Now();
-    if (fail[0]) { snprintf(err, errlen, "%s", fail); return false; }
+    if (fail[0]) { g_kept_count = 0; snprintf(err, errlen, "%s", fail); return false; }
+    cvars_after_restore();
     ph.log("restore");
     if (segs.va_recommitted) util::Log("[snap] %u VirtualAlloc ranges decommitted since the save were committed again", (unsigned)segs.va_recommitted);
     if (segs.va_skipped || segs.mods_skipped)
