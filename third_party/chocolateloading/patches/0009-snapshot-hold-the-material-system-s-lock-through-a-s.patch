diff --git a/src/sdk.h b/src/sdk.h
index c169aff..28067f3 100644
--- a/src/sdk.h
+++ b/src/sdk.h
@@ -87,6 +87,13 @@ namespace kvslot { enum { AllocKeyValuesMemory = 1, FreeKeyValuesMemory = 2 }; }
 // ---- IThreadPool (vstdlib g_pThreadPool) ------------------------------------------------------
 namespace poolslot { enum { NumThreads = 7, NumIdleThreads = 8, SuspendExecution = 9, ResumeExecution = 10 }; }
 
+// ---- IMaterialSystem ("VMaterialSystem080", materialsystem.dll) --------------------------------
+// GetThreadMode returns CMaterialSystem's current mode (0 = everything on the main thread, 2 = queued: each
+// frame's render calls run as a job on the thread pool while the main thread simulates the next one).
+// Lock() waits for that job, takes the material system's mutex and makes the device's own render context the
+// calling thread's; it returns the context the thread had, which Unlock() takes and puts back.
+namespace matslot { enum { GetThreadMode = 14, Lock = 116, Unlock = 117 }; }
+
 // ---- IFileSystem (VFileSystem017) -------------------------------------------------------------
 namespace fsslot { enum { AsyncFinishAll = 44, AsyncSuspend = 47, AsyncResume = 48 }; }
 
diff --git a/src/snapshot.cpp b/src/snapshot.cpp
index 0299808..dd7516c 100644
--- a/src/snapshot.cpp
+++ b/src/snapshot.cpp
@@ -26,6 +26,7 @@ Options g_opts;
 // ---- engine interfaces used to quiesce worker threads --------------------------------------------
 void*    g_pool = nullptr;      // IThreadPool*  (vstdlib g_pThreadPool)
 void*    g_fs = nullptr;        // IFileSystem*  (VFileSystem017)
+void*    g_matsys = nullptr;    // IMaterialSystem* (VMaterialSystem080), for the render lock
 void*    g_client = nullptr;    // IBaseClientDLL* (VClient016), for IN_ClearStates
 void*    g_sound = nullptr;     // IEngineSound* (IEngineSoundClient003)
 uint8_t* g_cengine = nullptr;   // the CEngine instance (its frame timing must survive a restore)
@@ -33,6 +34,8 @@ uint8_t* g_cengine = nullptr;   // the CEngine instance (its frame timing must s
 typedef int  (__thiscall* PoolIntFn)(void*);
 typedef void (__thiscall* FsFinishAllFn)(void*, int);
 typedef bool (__thiscall* FsBoolFn)(void*);
+typedef void* (__thiscall* MatLockFn)(void*);
+typedef int  (__thiscall* MatUnlockFn)(void*, void*);
 typedef void (__thiscall* VoidFn)(void*);
 typedef void (__thiscall* StopAllSoundsFn)(void*, bool);
 
@@ -98,6 +101,48 @@ void cvars_after_restore() {
     g_kept_count = 0;
 }
 
+// ---- the render lock ------------------------------------------------------------------------------
+// With queued rendering (mat_queue_mode 2) the main thread fills one of two queued render contexts while a job
+// plays the other one back to the device, and which of the two is the main thread's is kept in a thread-local
+// pointer, outside the snapshot. A restore brought the material system's memory back and left that pointer:
+// with the two contexts swapped since the save (every frame swaps them) the game queued its render calls into
+// the context the material system was about to play back, and with the mode changed since the save it drew
+// straight to the device while the material system took it for queued. Either ends in a crash in the render
+// calls a moment later, which is why queued rendering used to be switched off around every operation.
+//
+// The material system has a lock for exactly this (what the engine takes to touch materials from the main
+// thread in the middle of a frame): Lock() waits for the render job, takes the mutex and gives the thread the
+// device's context; Unlock() gives it back the context that Lock() returned. So a save is taken inside the
+// lock and keeps the context it got, and a restore, inside the lock as well, unlocks with the context of the
+// save: the state it has just brought back is the locked one of that moment, and Unlock() leaves the thread
+// with the context that goes with it.
+void* render_lock() {
+    return RenderLockUsable() ? vfunc<MatLockFn>(g_matsys, matslot::Lock)(g_matsys) : nullptr;
+}
+
+void render_unlock(void* context) {
+    if (context) vfunc<MatUnlockFn>(g_matsys, matslot::Unlock)(g_matsys, context);
+}
+
+bool module_code(const util::Module& m, const uint8_t* p) { return (uintptr_t)p >= m.base && (uintptr_t)p < m.end; }
+
+// Finds the material system and checks the vtable layout: GetThreadMode is a plain read of the mode field,
+// and the lock functions lie in the module's code.
+void find_material_system() {
+    g_matsys = gameapi::Interface("materialsystem.dll", "VMaterialSystem080");
+    util::Module ms;
+    if (!g_matsys || !util::GetModule("materialsystem.dll", &ms)) { g_matsys = nullptr; return; }
+    static const uint8_t kGetThreadMode[] = { 0x8B, 0x81, 0xA8, 0x2A, 0x00, 0x00, 0xC3 };   // mov eax,[ecx+2AA8h] / ret
+    const uint8_t* mode = vfunc<const uint8_t*>(g_matsys, matslot::GetThreadMode);
+    bool ok = module_code(ms, mode) && !memcmp(mode, kGetThreadMode, sizeof(kGetThreadMode))
+           && module_code(ms, vfunc<const uint8_t*>(g_matsys, matslot::Lock))
+           && module_code(ms, vfunc<const uint8_t*>(g_matsys, matslot::Unlock));
+    if (!ok) {
+        util::Log("material system layout check failed: queued rendering is switched off for every operation");
+        g_matsys = nullptr;
+    }
+}
+
 bool g_pool_suspended = false, g_fs_suspended = false;
 
 // Drain and park the job pool and the async filesystem so no job runs while memory is copied.
@@ -212,6 +257,7 @@ struct Snap {
     int       restores;
     uint64_t  checksum;
