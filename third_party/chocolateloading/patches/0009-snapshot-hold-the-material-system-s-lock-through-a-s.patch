     g_preserve_count = 0;
     if (g_cengine) add_preserve(g_cengine + 0x10, 0x1C, "CEngine frame timing");
 
-    util::Log("snapshot init: pool=%p fs=%p client=%p sound=%p", g_pool, g_fs, g_client, g_sound);
+    find_material_system();
+    util::Log("snapshot init: pool=%p fs=%p client=%p sound=%p matsys=%p", g_pool, g_fs, g_client, g_sound, g_matsys);
     if (!g_fs) { snprintf(err, errlen, "VFileSystem017 not found"); return false; }
     return true;
 }
@@ -861,6 +909,7 @@ bool Save(const char* name, char* err, size_t errlen) {
     double t0 = util::Now();
 
     // 1) prepare, with the other threads running
+    void* render_context = render_lock();
     quiesce_begin();
     refresh_modules();
     bool capture_va = g_opts.capture_va && vatrack::Installed();
@@ -870,6 +919,7 @@ bool Save(const char* name, char* err, size_t errlen) {
     char why[160];
     if (const char* fail = prepare_store(s, capture_va, &arena_room, why, sizeof(why))) {
         quiesce_end();
+        render_unlock(render_context);
         buffers_free(s);
         snprintf(err, errlen, "%s", fail);
         return false;
@@ -901,6 +951,8 @@ bool Save(const char* name, char* err, size_t errlen) {
     ph.mark("resume");
     util::MuteConsole(false);
     quiesce_end();
+    render_unlock(render_context);
+    s.render_context = render_context;
     arena::FlushPendingOld();
     double t2 = util::Now();
     if (fail) {
@@ -954,10 +1006,18 @@ bool Restore(const char* name, char* err, size_t errlen) {
     }
     bool other_level = s.level_gen != g_level_gen;   // the snapshot outlived a level change
     if (other_level) util::Log("[snap] restoring '%s' (map '%s') from '%s'", s.name, s.map, g_map);
+    // (a snapshot taken with the render lock switched off holds the game between two frames of a render thread
+    // that was stopped for it: it can't be restored into a game whose render thread is running)
+    if (!s.render_context && RenderLockUsable()) {
+        snprintf(err, errlen, "taken with render_lock 0: switch it off again to restore this one (snap_opt render_lock 0)");
+        return false;
+    }
     double t0 = util::Now();
     if (!dirty_ensure((s.image_end - arena::Base()) / 4096 + 16)) { snprintf(err, errlen, "out of memory (dirty page list)"); return false; }
 
     // 1) let go of the outside objects of the timeline being discarded, with the other threads running
+    // (inside the render lock from here: the guards talk to the device, which a render job would be using)
+    void* render_context = render_lock();
     stop_all_sounds();
     cvars_before_restore();
     guards_before_restore(slot);
@@ -1013,6 +1073,9 @@ bool Restore(const char* name, char* err, size_t errlen) {
     ph.mark("resume");
     util::MuteConsole(false);
     quiesce_end();
+    // (the state now in memory is the one locked at the save: unlocked with that lock's context, also when the
+    // lock has been switched off since. A restore that failed left the current state.)
+    render_unlock(fail[0] ? render_context : s.render_context);
     double t2 = util::Now();
     if (fail[0]) { g_kept_count = 0; snprintf(err, errlen, "%s", fail); return false; }
     cvars_after_restore();
