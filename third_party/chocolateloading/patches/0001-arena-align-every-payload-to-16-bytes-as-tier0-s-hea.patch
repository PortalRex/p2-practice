From 53f27d63287602b97c54337e510979aa844ad078 Mon Sep 17 00:00:00 2001
From: PortalRex <35444194+PortalRex@users.noreply.github.com>
Date: Sat, 7 Nov 2026 10:39:19 -0600
Subject: [PATCH 01/10] arena: align every payload to 16 bytes, as tier0's heap
 does

Blocks were multiples of 8 with the payload 8 bytes after the header, so
payloads were only 8-byte aligned. tier0's own allocator (CStdMemAlloc)
returns 16-byte aligned memory for anything over 8 bytes and the game's
SSE code relies on it: on gel maps the paint-contact code in server.dll
faults ("read of FFFFFFFF") as soon as chocolateloading.dll is loaded,
no snapshot needed (reproduced on sp_a3_jump_intro, every load).

Blocks are now multiples of 16 and the heap starts 8 bytes before a
16-byte boundary, so every header sits at 8 mod 16 and every payload on a
16-byte boundary. grow()'s near-the-end fallback is masked with ALIGN too.
Check() and arena_test now verify the invariant (the test fails with the
old heap start).

Cost: small blocks carry up to 15 bytes of padding instead of 7, and the
FL0/FL1 buckets below 256 bytes now only use their even slots.
---
 src/arena.cpp        | 14 ++++++++++----
 tests/arena_test.cpp |  2 ++
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/arena.cpp b/src/arena.cpp
index e72b6d3..aed1490 100644
--- a/src/arena.cpp
+++ b/src/arena.cpp
@@ -1,7 +1,8 @@
 #define _CRT_SECURE_NO_WARNINGS
 // Snapshot-aware TLSF heap. See arena.h for the snapshot model.
 //
-// Block layout (all sizes are multiples of 8, header included):
+// Block layout (all sizes are multiples of 16, header included; every header sits 8 bytes before a 16-byte
+// boundary, so every payload is 16-byte aligned):
 //   +0 prev_size  size of the previous physical block, valid only when F_PREVFREE is set
 //   +4 sizef      size | flags
 //   +8 payload    (free blocks: next/prev free-list links)
@@ -18,7 +19,9 @@ uintptr_t g_lo = 1, g_hi = 1;   // [g_lo, g_hi) = heap span used by Contains()
 namespace {
 
 enum : uint32_t { F_FREE = 1, F_PREVFREE = 2, F_FROZEN = 4, F_MASK = 7 };
-const uint32_t ALIGN = 8, HDR = 8, MIN_BLOCK = 16;
+// Blocks are multiples of 16 and every header sits 8 bytes before a 16-byte boundary, so every payload is
+// 16-byte aligned, as tier0's own heap returns it (the game's SSE code, the paint contacts among it, relies on it).
+const uint32_t ALIGN = 16, HDR = 8, MIN_BLOCK = 16;
 const uint32_t SL_LOG = 4, SL_COUNT = 1u << SL_LOG;
 const uint32_t FL_SHIFT = SL_LOG + 3;        // first FL class starts at 128 bytes
 const uint32_t SMALL = 1u << FL_SHIFT;
@@ -152,7 +155,7 @@ bool grow(uint32_t need) {
     uintptr_t delta = ((uintptr_t)need + GROW_MIN + 0xFFFF) & ~(uintptr_t)0xFFFF;
     uintptr_t new_top = old_top + delta;
     if (new_top + HDR > g_reserve_end) {
-        delta = ((g_reserve_end - HDR - old_top) & ~(uintptr_t)7);
+        delta = ((g_reserve_end - HDR - old_top) & ~(uintptr_t)(ALIGN - 1));
         if (delta < need) return false;
         new_top = old_top + delta;
     }
@@ -277,7 +280,7 @@ bool Init(size_t reserve_bytes) {
     g_ctl = (Control*)g_base;
     memset(g_ctl, 0, sizeof(Control));
     g_ctl->magic = MAGIC;
-    g_heap_start = (g_base + sizeof(Control) + 63) & ~(uintptr_t)63;
+    g_heap_start = ((g_base + sizeof(Control) + 63) & ~(uintptr_t)63) + HDR;   // (the first payload on a 16-byte boundary)
     // initial sentinel only; the first allocation grows the heap
     Hdr* s = (Hdr*)g_heap_start;
     s->prev_size = 0;
@@ -392,6 +395,9 @@ bool Check(char* err, size_t errlen) {
         if (s < MIN_BLOCK || (uintptr_t)h + s > (uintptr_t)top) {
             snprintf(err, errlen, "bad block size %u at %p", s, h); ok = false; break;
         }
+        if ((s & (ALIGN - 1)) || (((uintptr_t)h + HDR) & (ALIGN - 1))) {
+            snprintf(err, errlen, "misaligned block (size %u) at %p", s, h); ok = false; break;
+        }
         if (((h->sizef & F_PREVFREE) != 0) != prev_free) {
             snprintf(err, errlen, "PREVFREE mismatch at %p", h); ok = false; break;
         }
diff --git a/tests/arena_test.cpp b/tests/arena_test.cpp
index aa20b42..9401c82 100644
--- a/tests/arena_test.cpp
+++ b/tests/arena_test.cpp
@@ -53,6 +53,7 @@ static void random_ops(int n, std::vector<Obj>* outside, bool allow_outside) {
             Obj o; o.size = rand_size(); o.seed = rnd();
             o.p = (unsigned char*)arena::Alloc(o.size);
             if (!o.p) { printf("alloc failed\n"); exit(1); }
+            if ((uintptr_t)o.p & 15) { printf("alloc not 16-byte aligned: %p\n", o.p); exit(1); }
             fill(o);
             if (allow_outside && outside && (rnd() % 20) == 0) outside->push_back(o);
             else state_push(o);
@@ -69,6 +70,7 @@ static void random_ops(int n, std::vector<Obj>* outside, bool allow_outside) {
             uint32_t ns = o.size + rnd() % 3000;
             unsigned char* np = (unsigned char*)arena::Realloc(o.p, ns);
             if (!np) { printf("realloc failed\n"); exit(1); }
+            if ((uintptr_t)np & 15) { printf("realloc not 16-byte aligned: %p\n", np); exit(1); }
             o.p = np;
             for (uint32_t j = o.size; j < ns; j++) np[j] = (unsigned char)(o.seed + j * 31);
             o.size = ns;
